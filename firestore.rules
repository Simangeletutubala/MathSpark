rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "smangelent@gmail.com" && request.auth.token.email_verified == true
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ===============================================================
    // User Validation
    // ===============================================================
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role is string && data.role in ['buddy', 'parent', 'student'] &&
             // Ensure UID in data matches path UID if possible (handled in match)
             (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 256)) &&
             (!('buddyUids' in data) || (data.buddyUids is list && data.buddyUids.size() <= 50)) &&
             (!('childrenUids' in data) || (data.childrenUids is list && data.childrenUids.size() <= 50));
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin() || (
        isSignedIn() && (
          // Parents can get their buddies - using resource.data to avoid get() if possible in list queries
          // but for 'get' we might need to check the parent's doc
          (resource.data.parentEmail == request.auth.token.email && resource.data.role == 'buddy')
        )
      );

      allow list: if isSignedIn() && (
        isAdmin() || 
        (resource.data.parentEmail == request.auth.token.email && resource.data.role == 'buddy') ||
        (resource.data.role == 'parent') // Buddies finding parents
      );

      allow create: if isOwner(uid) && isValidUser(incoming()) && incoming().uid == uid;
      
      allow update: if (isOwner(uid) || isAdmin()) && isValidUser(incoming()) && (
        // Identity integrity
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().role == existing().role
      );
    }

    // ===============================================================
    // Struggled Questions
    // ===============================================================
    function isValidStruggledQuestion(data) {
      return data.keys().hasAll(['buddyUid', 'questionText', 'userAnswer', 'correctAnswer', 'operation', 'timestamp']) &&
             data.buddyUid is string && data.buddyUid.size() <= 128 &&
             data.questionText is string && data.questionText.size() <= 1000 &&
             data.userAnswer is string && data.userAnswer.size() <= 1000 &&
             data.correctAnswer is string && data.correctAnswer.size() <= 1000 &&
             data.operation is string && data.operation.size() <= 100 &&
             data.timestamp is string;
    }

    match /struggled_questions/{id} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.buddyUid) || 
        isAdmin() ||
        (resource.data.buddyUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.buddyUids)
      );
      
      allow list: if isSignedIn() && (
        isOwner(resource.data.buddyUid) || 
        isAdmin()
      );

      allow create: if isSignedIn() && isOwner(incoming().buddyUid) && isValidStruggledQuestion(incoming());
      allow update, delete: if isAdmin();
    }

    match /feedback/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}
